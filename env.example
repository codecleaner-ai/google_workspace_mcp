############################################
#
## Google Workspace MCP Server Environment Variables
## Copy this file to .env.local and fill in your values
#
############################################

# ============================================
# REQUIRED: Google OAuth 2.0 Credentials
# ============================================
# ⚠️  CRITICAL: Why does the MCP server need OAuth credentials if it doesn't handle OAuth flows?
#
# The MCP server does NOT initiate OAuth flows (the frontend does that). However, the MCP server
# STILL needs OAuth credentials for these purposes:
#
# 1. **Creating Credentials Objects**: When the MCP server receives an access token via
#    `X-Google-Access-Token` header, it must create a Google `Credentials` object to call
#    Google APIs. Google's `google.oauth2.credentials.Credentials` class REQUIRES `client_id`
#    and `client_secret` parameters, even when you already have an access token.
#
# 2. **Token Validation** (Optional): The server can validate tokens using Google's UserInfo API
#    to ensure they're valid and not expired. This requires OAuth credentials.
#
# 3. **Token Refresh** (If Needed): If an access token expires during a request, the server
#    needs credentials to refresh it (though in stateless mode, the backend should handle refresh).
#
# 📝 IMPORTANT: These credentials are used ONLY for:
#    - Creating Credentials objects from access tokens
#    - Token validation (optional)
#    - NOT for OAuth flows (frontend handles that)
#
# 🔗 They can be the SAME OAuth app as your frontend uses, or a separate one.
#
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project
# 3. Navigate to APIs & Services → Credentials
# 4. Create OAuth Client ID (Desktop Application type)
# 5. Copy Client ID and Client Secret

GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# ============================================
# REQUIRED: Transport Configuration
# ============================================
# Options: 'streamable-http' (for backend integration) or 'stdio' (for desktop apps)
TRANSPORT=streamable-http

# ============================================
# REQUIRED: API Key Protection
# ============================================
# Server-level API key for protecting all endpoints.
# This provides an additional layer of security beyond OAuth token validation.
#
# ⚠️  CRITICAL: This API key is REQUIRED for production deployments.
# Set this to a strong, randomly generated value (e.g., 32+ characters).
#
# For local development, you can leave this unset to disable API key protection,
# but this is NOT recommended for production.
#
# Generate a secure API key:
#   openssl rand -base64 32 | tr -d "=+/" | cut -c1-32
#
# Or using Python:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Store this securely:
#   - Local: Set in .env.local (git-ignored)
#   - Cloud Run: Store in Secret Manager as google-mcp-server-api-key
#
# Usage:
#   - Clients must include X-API-Key header with this value
#   - Backend should use same API key when calling MCP server
#   - Different API keys per environment (dev, qa, prod)
#
# Endpoints that DO NOT require API key (intentionally unprotected):
#   - /health (health check - acceptable tradeoff for easier setup and debugging)
#   - /oauth2callback (OAuth callback - must remain public)
#   - /.well-known/* (OAuth discovery - must remain public)
#
# All other endpoints require both:
#   1. X-API-Key header (server-level authentication)
#   2. X-Google-Access-Token header (user-level authentication)
#
GOOGLE_MCP_SERVER_API_KEY=your-secure-api-key-here

# ============================================
# REQUIRED for streamable-http transport: Port
# ============================================
# Default: 3003 (local development)
# For Cloud Run deployment: MUST be 8080
PORT=3003

# ============================================
# REQUIRED for Local Development: OAuth HTTP
# ============================================
# Allows OAuth to work over http:// (not https://) for local development
# ⚠️  NEVER set this in production - use HTTPS only
OAUTHLIB_INSECURE_TRANSPORT=1

# ============================================
# OPTIONAL: Server Configuration
# ============================================

# Default user email for single-user mode (optional)
# USER_GOOGLE_EMAIL=your.email@gmail.com

# Enable verbose debug logging (optional)
# DEBUG_MODE=true

# ============================================
# OPTIONAL: Advanced Configuration
# ============================================

# Enable OAuth 2.1 multi-user support (optional, default: false)
# MCP_ENABLE_OAUTH21=true

# Enable stateless mode for Cloud Run (optional, default: false)
# Requires MCP_ENABLE_OAUTH21=true
# WORKSPACE_MCP_STATELESS_MODE=true

# External OAuth 2.1 provider (optional, default: false)
# Requires MCP_ENABLE_OAUTH21=true
# EXTERNAL_OAUTH21_PROVIDER=true

# ============================================
# OPTIONAL: Google Search API (for search tools)
# ============================================

# Google Programmable Search Engine API Key (optional)
# GOOGLE_PSE_API_KEY=your-api-key

# Google Programmable Search Engine ID (optional)
# GOOGLE_PSE_ENGINE_ID=your-engine-id

# ============================================
# OPTIONAL: JWT Token Verification
# ============================================
# These are required ONLY if you need to support JWT tokens from Authorization: Bearer header
# JWT tokens are NOT the same as Google OAuth tokens (ya29.*)
#
# CRITICAL SECURITY: JWT signature verification is MANDATORY
# Without a verification key, JWT tokens will be REJECTED for security
#
# Choose ONE of the following based on your JWT algorithm:
#
# For HS256/HMAC algorithms (symmetric key):
# JWT_SECRET=your-jwt-secret-key-here
#
# For RS256/RSA algorithms (asymmetric key):
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
#
# Note: If neither is set, JWT tokens will be rejected (secure by default)
# JWT_SECRET=
# JWT_PUBLIC_KEY=

# ============================================
# OPTIONAL: Token Validation
# ============================================
# Disable token validation (default: true)
# Set to "false" to skip token verification for performance
# WARNING: Only disable in trusted environments
# GOOGLE_VALIDATE_TOKENS=true

############################################
# NOTES:
# - Copy this file to .env.local (git-ignored)
# - Never commit .env.local to version control
# - For production, use secret management (e.g., Google Secret Manager)
# - See user-manuals/developer/mcp-google-workspace/env-variables.md for details
############################################
