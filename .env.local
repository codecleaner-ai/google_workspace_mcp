############################################
#
## Google Workspace MCP Server Environment Variables
## Copy this file to .env.local and fill in your values
#
############################################

# ============================================
# REQUIRED: Google OAuth 2.0 Credentials
# ============================================
# Get these from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create/select a project
# 3. Navigate to APIs & Services → Credentials
# 4. Create OAuth Client ID (Desktop Application type)
# 5. Copy Client ID and Client Secret

GOOGLE_OAUTH_CLIENT_ID=66634186654-kd60v4t69aiil1g44183s8qb4r1r04cl.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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

# ============================================
# REQUIRED: Transport Configuration
# ============================================
# Options: 'streamable-http' (for backend integration) or 'stdio' (for desktop apps)
TRANSPORT=streamable-http

# ============================================
# REQUIRED for streamable-http transport: Port
# ============================================
# Default: 3003 (local development)
# For Cloud Run deployment: MUST be 8080
PORT=3003

# ============================================
# REQUIRED for Local Development: OAuth HTTP
# ============================================
# Allows OAuth to work over http:// (not https://) for local development
# ⚠️  NEVER set this in production - use HTTPS only
OAUTHLIB_INSECURE_TRANSPORT=1

# ============================================
# OPTIONAL: Server Configuration
# ============================================

# Default user email for single-user mode (optional)
# USER_GOOGLE_EMAIL=your.email@gmail.com

# Enable verbose debug logging (optional)
# DEBUG_MODE=true

# ============================================
# OPTIONAL: Advanced Configuration
# ============================================

# Enable OAuth 2.1 multi-user support (optional, default: false)
# MCP_ENABLE_OAUTH21=true

# Enable stateless mode for Cloud Run (optional, default: false)
# Requires MCP_ENABLE_OAUTH21=true
# WORKSPACE_MCP_STATELESS_MODE=true

# External OAuth 2.1 provider (optional, default: false)
# Requires MCP_ENABLE_OAUTH21=true
# EXTERNAL_OAUTH21_PROVIDER=true

# ============================================
# OPTIONAL: Google Search API (for search tools)
# ============================================

# Google Programmable Search Engine API Key (optional)
# GOOGLE_PSE_API_KEY=your-api-key

# Google Programmable Search Engine ID (optional)
# GOOGLE_PSE_ENGINE_ID=your-engine-id

# ============================================
# OPTIONAL: JWT Token Verification
# ============================================
# These are required ONLY if you need to support JWT tokens from Authorization: Bearer header
# JWT tokens are NOT the same as Google OAuth tokens (ya29.*)
#
# CRITICAL SECURITY: JWT signature verification is MANDATORY
# Without a verification key, JWT tokens will be REJECTED for security
#
# Choose ONE of the following based on your JWT algorithm:
#
# For HS256/HMAC algorithms (symmetric key):
# JWT_SECRET=your-jwt-secret-key-here
#
# For RS256/RSA algorithms (asymmetric key):
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"
#
# Note: If neither is set, JWT tokens will be rejected (secure by default)
# JWT_SECRET=
# JWT_PUBLIC_KEY=

# ============================================
# OPTIONAL: Token Validation
# ============================================
# Disable token validation (default: true)
# Set to "false" to skip token verification for performance
# WARNING: Only disable in trusted environments
# GOOGLE_VALIDATE_TOKENS=true

############################################
# NOTES:
# - Copy this file to .env.local (git-ignored)
# - Never commit .env.local to version control
# - For production, use secret management (e.g., Google Secret Manager)
# - See user-manuals/developer/mcp-google-workspace/env-variables.md for details
############################################
